{
    "lines": [
        {
            "text": "This is an example of the dialogue engine.",
            "sfx": "tink.wav"
        },
        {
            "text": "First time here? Take a look around.",
            "unless": "demo_met",
            "set": [
                "demo_met"
            ]
        },
        {
            "text": "Back again! Still exploring?",
            "if": "demo_met"
        },
        {
            "text": "Want a lift to the clearing?",
            "music": ""
        },
        {
            "choice": [
                {
                    "text": "Sure",
                    "set": [
                        "demo_agreed"
                    ]
                },
                {
                    "text": "Not now"
                }
            ]
        },
        {
            "text": "Hold on tight!",
            "if": "demo_agreed",
            "warp": {
                "room": "02.json",
                "tile": [
                    4,
                    5
                ]
            }
        },
        {
            "text": "Suit yourself.",
            "unless": "demo_agreed",
            "set": [
                "demo_refused"
            ]
        },
        {
            "text": "Bye now!"
        }
    ]
}